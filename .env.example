# Copie este arquivo para ".env" e preencha com as credenciais do SEU
# projeto Firebase (Console Firebase > Configurações do projeto > Seus apps
# > SDK setup and configuration > Config).
#
# Enquanto VITE_USE_EMULATORS=true, nenhuma dessas variáveis precisa ser
# real - o app conversa com o Firebase Local Emulator Suite rodando na sua
# própria máquina (veja README.md > "Rodando com os emuladores").
#
# IMPORTANTE (leia antes de rodar): com esse arquivo copiado sem mais
# nenhum ajuste, o LOGIN NÃO VAI FUNCIONAR - o app tenta falar com o
# emulador de Auth em 127.0.0.1:9099 e não existe ninguém lá até você
# rodar `npx firebase emulators:start --only auth` em outro terminal.
# As TASKS (Home/Dashboard) funcionam sem nenhum passo extra, porque
# VITE_DATA_BACKEND=mock abaixo liga o dublê em memória por padrão.
# Ver README.md > "Rodando localmente" para o passo a passo completo.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Chave VAPID pública, necessária para o Firebase Cloud Messaging (Web Push).
# Gerada em: Console Firebase > Project Settings > Cloud Messaging >
# Web configuration > Web Push certificates.
VITE_FIREBASE_VAPID_KEY=

# true = conecta nos emuladores locais (Auth :9099, Firestore :8080).
# false (ou ausente) = conecta no projeto Firebase real acima.
VITE_USE_EMULATORS=true

# "mock"      = tasks funcionam na hora, sem precisar de nada rodando
#               (dublê em memória - ver src/services/taskService.mock.js).
# "firestore" = tasks vão de verdade para o Firestore (emulador ou real) -
#               exige o emulador de Firestore rodando OU um projeto real.
VITE_DATA_BACKEND=mock
